# Quote requests are always emailed to leadEmail in src/config/site.ts.

# Optional: send leads ONLY to this endpoint instead (Formspree, Basin,
# Zapier/Make webhook, your own API). Leave blank to keep email + Supabase.
VITE_LEAD_ENDPOINT=

# Also save every lead to Supabase. Run supabase/migrations/001_leads.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 measurement ID. Defaults to G-JDGPSR18GZ (set in
# src/lib/analytics.ts); only set this to use a different property.
VITE_GA_ID=
