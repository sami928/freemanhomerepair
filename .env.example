# Where quote requests are sent. Leave all blank in development and
# submissions are logged to the browser console instead.

# Option A — any endpoint that accepts a JSON POST (Formspree, Basin,
# Zapier/Make webhook, your own API). Takes precedence if set.
VITE_LEAD_ENDPOINT=

# Option B — Supabase. Run supabase/migrations/001_leads.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Google Analytics 4 measurement ID (G-XXXXXXX).
VITE_GA_ID=
