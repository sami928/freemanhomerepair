# Apache / LiteSpeed (Hostinger) config. scripts/prerender.mjs fills in the
# "@routes" block at build time — edit the template in public/.htaccess.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Hashed build files (/assets/*.js, *.css, *.woff2) never change: cache 1 year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages: always check for a new deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One host: www → bare domain.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # One URL per page: drop trailing slashes.
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Prerendered files are served under their clean URL only.
  # (Skipped on the internal request for /404.html itself.)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/_pages/ [NC]
  RewriteRule ^ - [R=404,L]

  # Home page.
  RewriteRule ^(index\.html)?$ - [L]

  # @routes

  # Real files: assets, images, sitemap, prerendered pages, 404.html.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Anything else is not a page: real 404 (served from /404.html).
  RewriteRule ^ - [R=404,L]
</IfModule>
